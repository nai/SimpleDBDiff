@page "/"
@using Npgsql
@implements IDisposable
@inject ISchemaReader SchemaReader
@inject IMigrationGenerator MigrationGenerator
@inject ConnectionProfileStore ProfileStore
@inject PasswordVault Vault
@inject ComparisonSessionStore SessionStore
@inject ILogger<Home> Logger

<PageTitle>SimpleDBDiff</PageTitle>

<header class="app-header">
    <a class="brand" href="/">SimpleDBDiff</a>
    <span class="direction-note">Left source → Right target</span>
    <FluentButton OnClick="() => SessionsOpen = !SessionsOpen" Disabled="Busy">Sessions</FluentButton>
    <span role="status">@SaveStatus</span>
    @if (SaveFailed) { <FluentButton OnClick="RetrySave" Disabled="Saving">Retry Save</FluentButton> }
    <span role="status">@(Vault.IsOpen ? "Vault open" : "Vault locked")</span>
    <FluentButton Disabled="Busy" OnClick="() => VaultPanel = !VaultPanel">Open Vault</FluentButton>
    <FluentButton Disabled="@(!Vault.IsOpen || Busy)" OnClick="CloseVault">Close Vault</FluentButton>
        <div class="command-actions">
            <FluentButton Appearance="ButtonAppearance.Primary" Disabled="@(Busy || !CanCompare)" OnClick="CompareAsync">Compare schemas</FluentButton>
            <FluentButton Disabled="@(Busy || !CanCompare || Selection is null || Selection.SelectedObjectCount == 0)" OnClick="GenerateSql">Generate SQL</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Subtle" Disabled="Busy" OnClick="Swap"><span class="swap-symbol" aria-hidden="true">⇄</span> Swap sides</FluentButton>
            @if (Busy) { <FluentSpinner aria-label="Working" /> }
        </div>
</header>
@if (SessionsOpen)
{
    <section class="sessions-panel" aria-label="Saved comparison sessions">
        <h2>Sessions</h2>
        <FluentButton OnClick="NewSessionAsync" Disabled="@(Busy || Saving)">New Session</FluentButton>
        @if (Sessions.Count == 0) { <p>No saved sessions. Create a session to save your workspace automatically.</p> }
        @foreach (var session in Sessions)
        {
            <div class="session-row" @key="session.Id">
                <FluentButton OnClick="() => LoadSessionAsync(session)" Disabled="@(Busy || Saving)">@session.Name</FluentButton>
                <span>@session.Left.Database → @session.Right.Database</span>
                <FluentButton OnClick="() => BeginRename(session)" Disabled="@(Busy || Saving)">Rename</FluentButton>
                <FluentButton OnClick="() => DeleteSessionAsync(session)" Disabled="@(Busy || Saving)">Delete</FluentButton>
            </div>
        }
        @if (RenameId is not null)
        {
            <FluentTextInput Label="Session name" @bind-Value="RenameName" />
            <FluentButton OnClick="RenameSessionAsync" Disabled="@(Busy || Saving)">Save name</FluentButton>
        }
    </section>
}
@if (PendingSession is not null)
{
    <section class="sessions-panel" aria-label="Session passwords">
        <h2>Connect this session</h2>
        <p>Open the vault to retrieve saved passwords, or enter passwords below. Then load fresh schemas and compare.</p>
        <FluentTextInput Label="Left database password" TextInputType="TextInputType.Password" @bind-Value="Left.Password" AutoComplete="off" />
        <FluentTextInput Label="Right database password" TextInputType="TextInputType.Password" @bind-Value="Right.Password" AutoComplete="off" />
        <FluentButton OnClick="ContinueSessionAsync" Disabled="Busy">Connect and compare</FluentButton>
    </section>
}
@if (VaultPanel)
{
    <div class="vault-panel">
        <FluentTextInput Label="Shared vault passphrase" TextInputType="TextInputType.Password" @bind-Value="VaultPassphrase" AutoComplete="off" />
        <FluentButton OnClick="OpenVaultAsync" Disabled="@(Busy || Vault.IsOpen)">Open or create vault</FluentButton>
        <p>One passphrase protects all saved passwords. A new vault is created on first use.</p>
        @if (VaultError is not null) { <p role="alert">@VaultError</p> }
    </div>
}
<div class="workspace-page">
    @if (ActiveSession is null) { <p class="session-hint">Choose a saved session or New Session to enable automatic saving.</p> }
    <div class="connections" aria-label="Database connections">
        <ConnectionCard @key="Left" State="Left" IsSource="true" Profiles="Profiles" Busy="Busy" OnLoadProfile="() => LoadProfileAsync(Left)" OnSaveProfile="() => SaveAndConnectAsync(Left)" OnTest="() => TestAsync(Left)" VaultOpen="Vault.IsOpen" OnLoadSchema="() => LoadSingleAsync(Left)" OnConnectionChanged="() => ConnectionChanged(Left)" />
        <ConnectionCard @key="Right" State="Right" IsSource="false" Profiles="Profiles" Busy="Busy" OnLoadProfile="() => LoadProfileAsync(Right)" OnSaveProfile="() => SaveAndConnectAsync(Right)" OnTest="() => TestAsync(Right)" VaultOpen="Vault.IsOpen" OnLoadSchema="() => LoadSingleAsync(Right)" OnConnectionChanged="() => ConnectionChanged(Right)" />
    </div>

    @if (Error is not null) { <div class="inline-message error workspace-error" role="alert">@Error</div> }

    <div class="comparison-workspace" aria-busy="@Busy">
        <aside class="object-explorer" aria-label="Table explorer">
            <div class="explorer-heading"><h2>Tables</h2><span class="count-badge">@TableEntries.Count</span></div>
            <div class="explorer-search"><FluentTextInput AriaLabel="Find a table" Placeholder="Search schemas and tables" @bind-Value="Search" Immediate="true" Width="100%" TextInputType="TextInputType.Search" /></div>
            <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="() => FiltersOpen = !FiltersOpen" aria-expanded="@FiltersOpen">Filters</FluentButton>
            @if (FiltersOpen)
            {
            <fieldset class="status-filters">
                <legend>Show results</legend>
                <FluentCheckbox Label="Equal" @bind-Value="ShowEqual" />
                <FluentCheckbox Label="Different" @bind-Value="ShowDifferent" />
                <FluentCheckbox Label="Left only" @bind-Value="ShowLeftOnly" />
                <FluentCheckbox Label="Right only" @bind-Value="ShowRightOnly" />
            </fieldset>
            }
            @if (Selection is not null)
            {
                <div class="selection-tools table-selection-tools" aria-label="Table selection controls">
                    <FluentButton Appearance="ButtonAppearance.Subtle" Disabled="Busy" OnClick="() => SetAllTables(true)" Title="Include all tables; preserve object selections, including hidden results">Check all</FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Subtle" Disabled="Busy" OnClick="() => SetAllTables(false)" Title="Skip all tables; preserve object selections, including hidden results">Uncheck all</FluentButton>
                    <span>All tables · filters only change visibility</span>
                </div>
            }
            <div class="table-navigation">
                @if (TableEntries.Count == 0)
                {
                    <div class="explorer-empty"><span aria-hidden="true">▦</span><p>Your tables will appear here after loading a schema.</p></div>
                }
                else if (!VisibleTables.Any())
                {
                    <p class="navigation-message">No tables match your search and filters.</p>
                }
                @foreach (var table in VisibleTables)
                {
                    <div class="table-selection-entry @(SelectedTable == table.Key ? "selected" : "")">
                        @if (Selection is not null)
                        {
                            <FluentCheckbox Disabled="Busy" Value="@Selection.TableState(table.Key)" ValueChanged="_ => ToggleTable(table.Key)" AriaLabel="@($"Include table {table.Key} in migration")" />
                        }
                        <button type="button" class="table-entry" aria-pressed="@(SelectedTable == table.Key)" @onclick="() => SelectTable(table.Key)">
                            <span class="table-entry-text"><strong>@table.Key</strong>
                                @if (Selection?.NeedsReview.Any(k => k.TableKey == table.Key) == true) { <span class="review-marker">Review after refresh</span> }
                                @if (Rows is not null)
                                {
                                    <span class="table-counts" aria-label="@($"{table.Counts.Different} different, {table.Counts.RightOnly} right only, {table.Counts.LeftOnly} left only")">
                                        <span class="different" title="Different objects">D×@table.Counts.Different</span>
                                        <span class="right-only" title="Right-only objects">R×@table.Counts.RightOnly</span>
                                        <span class="left-only" title="Left-only objects">L×@table.Counts.LeftOnly</span>
                                    </span>
                                }
                                else { <span>Not compared</span> }
                            </span>
                        </button>
                    </div>
                }
            </div>
            <div class="explorer-footer">@VisibleTables.Count() of @TableEntries.Count tables</div>
        </aside>

        <section class="comparison-panel" aria-label="Schema comparison">
            @if (Rows is null)
            {
                <div class="empty-workspace">
                    <div class="empty-illustration" aria-hidden="true"><span>▦</span><span class="empty-arrow">⇄</span><span>▦</span></div>
                    <p class="eyebrow">A CLEAR VIEW OF YOUR SCHEMA</p>
                    <h2>Start with two databases</h2>
                    <p>Choose a source and a target, then compare their tables, columns, constraints, and indexes.</p>
                    <div class="setup-steps"><span><b>1</b> Configure connections</span><span><b>2</b> Compare schemas</span><span><b>3</b> Review migration SQL</span></div>
                    <div class="empty-tip">The source is the reference. Generated SQL brings the target into line with it.</div>
                </div>
            }
            else
            {
                @if (Selection?.NeedsReview.Count > 0) { <p class="inline-message" role="status">@Selection.NeedsReview.Count new or changed objects need review. Their migration selections were cleared.</p> }
                <FluentTabs @bind-ActiveTabId="ActiveTab" Class="workspace-tabs">
                    <FluentTab Id="details" Header="Schema details">
                        <div class="detail-heading"><div><p class="eyebrow">TABLE COMPARISON</p><h2>@(SelectedTable ?? "Select a table")</h2></div><span class="status-badge @ComparisonPresentation.StatusClass(SelectedKind)">@ComparisonPresentation.StatusLabel(SelectedKind)</span></div>
                        @if (SelectedTable is not null)
                        {
                            <div class="comparison-direction"><span><b>L</b> @Left.Database <small>source</small></span><span><b>R</b> @Right.Database <small>target</small></span></div>
                            <div class="selection-tools detail-selection-tools" aria-label="Detail selection controls">
                                <span>Include in migration</span>
                                <FluentButton Appearance="ButtonAppearance.Subtle" Disabled="Busy" OnClick="() => SetAllDetails(true)" Title="Check every object in this table, including hidden results">Check all</FluentButton>
                                <FluentButton Appearance="ButtonAppearance.Subtle" Disabled="Busy" OnClick="() => SetAllDetails(false)" Title="Uncheck every object in this table, including hidden results">Uncheck all</FluentButton>
                            </div>
                            @if (Selection is not null && !Selection.TableState(SelectedTable))
                            {
                                <p class="field-hint" role="status">This table is skipped. Object selections are preserved for when you include it again.</p>
                            }
                            @if (!SelectedRows.Any())
                            {
                                <div class="detail-empty">No objects match the selected status filters. Enable another result type to see more.</div>
                            }
                            else
                            {
                                <div class="detail-grid-scroll">
                                    <FluentDataGrid TGridItem="SchemaDifference" Items="@SelectedRows.AsQueryable()" MultiLine="true" GridTemplateColumns="80px minmax(140px, 1fr) 112px minmax(0, 1.6fr) minmax(0, 1.6fr)" Class="schema-grid">
                                        <TemplateColumn Title="Include" Context="row"><FluentCheckbox Disabled="Busy" Value="@(Selection?.IsSelected(row) ?? false)" ValueChanged="(bool value) => SetObject(row, value)" AriaLabel="@($"Include {row.ObjectType.Split(' ')[0].ToLowerInvariant()} {row.ObjectName} in migration")" /></TemplateColumn>
                                        <TemplateColumn Title="Object" Context="row"><span class="object-name">@row.ObjectName</span>@if (Selection?.NeedsReview.Contains(ComparisonPresentation.ObjectKey(row)) == true) { <span class="review-marker">Review after refresh</span> }<span class="object-type">@row.ObjectType.Split(' ')[0]</span></TemplateColumn>
                                        <TemplateColumn Title="Status" Context="row"><span class="status-badge @ComparisonPresentation.StatusClass(row.Kind)">@ComparisonPresentation.StatusLabel(row.Kind)</span></TemplateColumn>
                                        <TemplateColumn Title="Left · source" Context="row"><code class="definition @(row.LeftDefinition is null ? "missing" : "")">@(row.LeftDefinition ?? "Not present")</code></TemplateColumn>
                                        <TemplateColumn Title="Right · target" Context="row"><code class="definition @(row.RightDefinition is null ? "missing" : "")">@(row.RightDefinition ?? "Not present")</code></TemplateColumn>
                                    </FluentDataGrid>
                                </div>
                            }
                        }
                    </FluentTab>
                    <FluentTab Id="sql" Header="Migration SQL">
                        <div class="detail-heading"><div><p class="eyebrow">POSTGRESQL SCRIPT</p><h2>Source → target</h2></div>@if (Script is not null) { <a class="download-link" href="@ScriptDownload" download="migration.sql">Download .sql <span aria-hidden="true">↓</span></a> }</div>
                        <div class="script-note">Review before running. This script can drop objects or alter data types. The application does not execute it.</div>
                        @if (Script is null)
                        {
                            <div class="sql-empty"><h2>Generate SQL for your selection</h2><p>Check the tables and objects you want to migrate, then click Generate SQL. Changing your selection clears the previous script.</p><FluentButton Appearance="ButtonAppearance.Primary" Disabled="@(!CanCompare || Selection is null || Selection.SelectedObjectCount == 0)" OnClick="GenerateSql">Generate SQL</FluentButton></div>
                        }
                        else { <pre class="sql-editor" tabindex="0" aria-label="Read-only PostgreSQL migration script"><code>@Script</code></pre> }
                    </FluentTab>
                </FluentTabs>
                <div class="comparison-summary" role="status"><span><span class="status-dot"></span>Comparison complete</span><span>@(Selection?.SelectedChangeCount ?? 0) of @ChangeCount changes selected · @TableEntries.Count tables</span></div>
            }
        </section>
    </div>
</div>

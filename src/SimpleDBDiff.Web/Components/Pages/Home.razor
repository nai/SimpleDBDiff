@page "/"
@using Npgsql
@implements IDisposable
@inject ISchemaReader SchemaReader
@inject IMigrationGenerator MigrationGenerator
@inject ConnectionProfileStore ProfileStore
@inject ILogger<Home> Logger

<PageTitle>Schema workspace · SimpleDBDiff</PageTitle>

<div class="workspace-page">
    <div class="page-heading">
        <div><p class="eyebrow">DATABASE TOOLS</p><h1>Schema workspace</h1><p class="page-description">Compare structure. Understand the differences. Plan your migration.</p></div>
        <span class="review-label"><span class="status-dot"></span>Review mode</span>
    </div>

    <div class="connections" aria-label="Database connections">
        <ConnectionCard @key="Left" State="Left" IsSource="true" Profiles="Profiles" Busy="Busy" OnLoadProfile="() => LoadProfileAsync(Left)" OnSaveProfile="() => SaveProfileAsync(Left)" OnLoadSchema="() => LoadSingleAsync(Left)" OnConnectionChanged="() => ConnectionChanged(Left)" />
        <ConnectionCard @key="Right" State="Right" IsSource="false" Profiles="Profiles" Busy="Busy" OnLoadProfile="() => LoadProfileAsync(Right)" OnSaveProfile="() => SaveProfileAsync(Right)" OnLoadSchema="() => LoadSingleAsync(Right)" OnConnectionChanged="() => ConnectionChanged(Right)" />
    </div>

    <div class="command-bar">
        <div class="command-actions">
            <FluentButton Appearance="ButtonAppearance.Primary" Disabled="@(Busy || !CanCompare)" OnClick="CompareAsync">@(Busy ? "Loading schemas…" : "Compare schemas")</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Subtle" Disabled="Busy" OnClick="Swap"><span class="swap-symbol" aria-hidden="true">⇄</span> Swap sides</FluentButton>
            @if (Busy) { <FluentSpinner aria-label="Loading schemas" /> }
        </div>
        <span class="direction-note">Left source <span aria-hidden="true">→</span> Right target</span>
    </div>
    @if (Error is not null) { <div class="inline-message error workspace-error" role="alert">@Error</div> }

    <div class="comparison-workspace" aria-busy="@Busy">
        <aside class="object-explorer" aria-label="Table explorer">
            <div class="explorer-heading"><h2>Tables</h2><span class="count-badge">@TableEntries.Count</span></div>
            <div class="explorer-search"><FluentTextInput Label="Find a table" Placeholder="Search schemas and tables" @bind-Value="Search" Immediate="true" Width="100%" TextInputType="TextInputType.Search" /></div>
            <fieldset class="status-filters">
                <legend>Show results</legend>
                <FluentCheckbox Label="Equal" @bind-Value="ShowEqual" />
                <FluentCheckbox Label="Different" @bind-Value="ShowDifferent" />
                <FluentCheckbox Label="Left only" @bind-Value="ShowLeftOnly" />
                <FluentCheckbox Label="Right only" @bind-Value="ShowRightOnly" />
            </fieldset>
            <div class="table-navigation">
                @if (TableEntries.Count == 0)
                {
                    <div class="explorer-empty"><span aria-hidden="true">▦</span><p>Your tables will appear here after loading a schema.</p></div>
                }
                else if (!VisibleTables.Any())
                {
                    <p class="navigation-message">No tables match your search and filters.</p>
                }
                @foreach (var table in VisibleTables)
                {
                    <button type="button" class="table-entry @(SelectedTable == table.Key ? "selected" : "")" aria-pressed="@(SelectedTable == table.Key)" @onclick="() => SelectTable(table.Key)">
                        <span class="table-glyph" aria-hidden="true">▦</span>
                        <span class="table-entry-text"><strong>@table.Key</strong><span>@ComparisonPresentation.StatusLabel(table.Kind)</span></span>
                        <span class="object-indicator @ComparisonPresentation.StatusClass(table.Kind)" aria-hidden="true"></span>
                    </button>
                }
            </div>
            <div class="explorer-footer">@VisibleTables.Count() of @TableEntries.Count tables</div>
        </aside>

        <section class="comparison-panel" aria-label="Schema comparison">
            @if (Rows is null)
            {
                <div class="empty-workspace">
                    <div class="empty-illustration" aria-hidden="true"><span>▦</span><span class="empty-arrow">⇄</span><span>▦</span></div>
                    <p class="eyebrow">A CLEAR VIEW OF YOUR SCHEMA</p>
                    <h2>Start with two databases</h2>
                    <p>Choose a source and a target, then compare their tables, columns, constraints, and indexes.</p>
                    <div class="setup-steps"><span><b>1</b> Configure connections</span><span><b>2</b> Compare schemas</span><span><b>3</b> Review migration SQL</span></div>
                    <div class="empty-tip">The source is the reference. Generated SQL brings the target into line with it.</div>
                </div>
            }
            else
            {
                <FluentTabs @bind-ActiveTabId="ActiveTab" Class="workspace-tabs">
                    <FluentTab Id="details" Header="Schema details">
                        <div class="detail-heading"><div><p class="eyebrow">TABLE COMPARISON</p><h2>@(SelectedTable ?? "Select a table")</h2></div><span class="status-badge @ComparisonPresentation.StatusClass(SelectedKind)">@ComparisonPresentation.StatusLabel(SelectedKind)</span></div>
                        @if (SelectedTable is not null)
                        {
                            <div class="comparison-direction"><span><b>L</b> @Left.Database <small>source</small></span><span><b>R</b> @Right.Database <small>target</small></span></div>
                            @if (!SelectedRows.Any())
                            {
                                <div class="detail-empty">No objects match the selected status filters. Enable another result type to see more.</div>
                            }
                            else
                            {
                                <div class="detail-grid-scroll">
                                    <FluentDataGrid TGridItem="SchemaDifference" Items="@SelectedRows.AsQueryable()" MultiLine="true" GridTemplateColumns="minmax(140px, 1fr) 100px minmax(0, 1.6fr) minmax(0, 1.6fr)" Class="schema-grid">
                                        <TemplateColumn Title="Object" Context="row"><span class="object-name">@row.ObjectName</span><span class="object-type">@row.ObjectType.Split(' ')[0]</span></TemplateColumn>
                                        <TemplateColumn Title="Status" Context="row"><span class="status-badge @ComparisonPresentation.StatusClass(row.Kind)">@ComparisonPresentation.StatusLabel(row.Kind)</span></TemplateColumn>
                                        <TemplateColumn Title="Left · source" Context="row"><code class="definition @(row.LeftDefinition is null ? "missing" : "")">@(row.LeftDefinition ?? "Not present")</code></TemplateColumn>
                                        <TemplateColumn Title="Right · target" Context="row"><code class="definition @(row.RightDefinition is null ? "missing" : "")">@(row.RightDefinition ?? "Not present")</code></TemplateColumn>
                                    </FluentDataGrid>
                                </div>
                            }
                        }
                    </FluentTab>
                    <FluentTab Id="sql" Header="Migration SQL">
                        <div class="detail-heading"><div><p class="eyebrow">POSTGRESQL SCRIPT</p><h2>Source → target</h2></div><a class="download-link" href="@ScriptDownload" download="migration.sql">Download .sql <span aria-hidden="true">↓</span></a></div>
                        <div class="script-note">Review before running. This script can drop objects or alter data types. The application does not execute it.</div>
                        <pre class="sql-editor" tabindex="0" aria-label="Read-only PostgreSQL migration script"><code>@Script</code></pre>
                    </FluentTab>
                </FluentTabs>
                <div class="comparison-summary" role="status"><span><span class="status-dot"></span>Comparison complete</span><span>@ChangeCount object changes · @TableEntries.Count tables</span></div>
            }
        </section>
    </div>
</div>

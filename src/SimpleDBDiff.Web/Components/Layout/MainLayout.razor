@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <a class="brand" href="/" aria-label="SimpleDBDiff home">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><ellipse cx="12" cy="5" rx="7" ry="3" /><path d="M5 5v14c0 1.65 3.13 3 7 3s7-1.35 7-3V5M5 12c0 1.65 3.13 3 7 3s7-1.35 7-3" /></svg>
            </span>
            <span>Simple<span class="brand-light">DBDiff</span></span>
        </a>
        <span class="header-divider"></span><span class="header-location">Schema comparison</span>
        <span class="header-badge">PostgreSQL</span>
    </header>
    <main id="main-content">@Body</main>
    <footer class="app-footer"><span>Stage 1 · Schema comparison</span><span>SQL review only · No changes are executed</span></footer>
</div>
<FluentProviders />
<div id="blazor-error-ui" role="alert">The connection was interrupted. <a href=".">Reload the workspace</a></div>
